# ---------------------------------------------------------------------------
# Public site environment
#
# NEXT_PUBLIC_PLATFORM_URL is the origin where the Construction AI platform
# (login, dashboard) is hosted — for example https://app.example.com.
#
# Leave it unset and every link into the platform is simply not rendered.
# That is the default on purpose: a button that opens a dead page is worse
# than no button, and the platform is not deployed yet.
#
# It is read at BUILD time (NEXT_PUBLIC_* is inlined into the bundle), so a
# change to it needs a redeploy, not just a restart.
# ---------------------------------------------------------------------------

# NEXT_PUBLIC_PLATFORM_URL=https://app.example.com

# ---------------------------------------------------------------------------
# Contact form
#
# NEXT_PUBLIC_WEB3FORMS_KEY lets the Contact us form send messages straight
# from the site. Get a free key at https://web3forms.com by entering the
# address that should receive enquiries; the key arrives by e-mail.
#
# Unset, the form falls back to opening the visitor's own mail app. Like the
# platform URL it is inlined at BUILD time, so changing it needs a rebuild.
# ---------------------------------------------------------------------------

# NEXT_PUBLIC_WEB3FORMS_KEY=700da2fa-43a1-4278-a8cd-febe25d532c9
